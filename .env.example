# =====================================================================
# OLNOO AI Router — environment configuration
#
# Copy this file to .env and fill in real values.
# Never commit .env or real secrets to version control.
# =====================================================================

# ---- Service ----
NODE_ENV=development
SERVICE_NAME=olnoo-ai-router
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Allows base64-encoded multimodal requests (default: 32 MiB).
BODY_LIMIT_BYTES=33554432

# ---- Security ----
# Comma-separated list of API keys allowed to call this router.
# Callers send one of these values in the "x-api-key" header.
API_KEYS=change-me-local-dev-key

# Requests allowed per API key within RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Set to true only when running behind a trusted reverse proxy (for client IP resolution).
TRUST_PROXY=false

# ---- Provider request behavior ----
PROVIDER_REQUEST_TIMEOUT_MS=120000

# ---- Gemini provider ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models this deployment is allowed to route to.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite-image,gemini-3.1-flash-image,gemini-3-pro-image
